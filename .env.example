# ── Polymarket credentials ────────────────────────────────────────────────
# 1. Set POLY_PRIVATE_KEY (Ethereum hex private key, no 0x prefix needed)
# 2. Run: python -c "from api_clients.polymarket_client import print_api_creds; print_api_creds()"
# 3. Paste the printed values below
POLY_PRIVATE_KEY=
POLY_WALLET_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# ── Trading mode ──────────────────────────────────────────────────────────
# DRY_RUN=true  → log simulated trades, no real orders placed
# DRY_RUN=false → live trading (requires credentials above)
DRY_RUN=true

# ── Paper trading ─────────────────────────────────────────────────────────
# Virtual bankroll used for Kelly position sizing in dry-run mode.
# Also used as fallback when the balance API is unreachable.
# Set this to the amount you'd realistically deploy (affects trade sizes).
PAPER_BANKROLL=1000.0

# ── Risk limits ───────────────────────────────────────────────────────────
MAX_DAILY_USD=1000.0          # max USD deployed across all strategies per day
PER_STRATEGY_MAX_USD=300.0    # max USD deployed per strategy per day
MAX_POSITION_USD=100.0        # hard cap per individual trade
MAX_TOTAL_EXPOSURE_USD=500.0  # max total open exposure at any time

# ── Alerting ──────────────────────────────────────────────────────────────
# Discord webhook for fill alerts, daily summary, and circuit breaker alerts.
# Create one at: Discord server → Edit Channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
ALERT_LARGE_FILL_USD=50.0     # alert threshold for individual fills

# ── LLM (Claude) ──────────────────────────────────────────────────────────
# Used by: LLM signal strategy + Evolution agent (weekly performance review)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_ENABLED=false
LLM_MODEL=claude-haiku-4-5-20251001

# ── News signal ───────────────────────────────────────────────────────────
# Used by the news-fade strategy (optional — strategy still runs without it)
# Free tier at https://newsapi.org (1000 req/day)
NEWS_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────
DB_PATH=data/leo.db

# ── Web dashboard ─────────────────────────────────────────────────────────
LEO_WEB_PORT=5002

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Strategy toggles (all default true — set false to disable) ────────────
# ARB_ENABLED=true
# CRYPTO_SIGNAL_ENABLED=true
# RANGE_STRADDLE_ENABLED=true
# CROSS_ARB_ENABLED=true
# CORR_ENABLED=true
# NEWS_FADE_ENABLED=true
# FORECAST_ENABLED=true
# LLM_ENABLED=false
# WEATHER_ENABLED=true
# FAV_SHORT_ENABLED=true
# ORACLE_SQUEEZE_ENABLED=true
# SEMANTIC_ARB_ENABLED=true
# OFI_ENABLED=true
# MM_ENABLED=true
# BTC5MIN_ENABLED=true

# ── Circuit breaker ───────────────────────────────────────────────────────
# CIRCUIT_BREAKER_ERRORS=5      # consecutive CLOB errors before pausing
# CIRCUIT_BREAKER_PAUSE_SEC=120 # how long to pause after breaker trips
