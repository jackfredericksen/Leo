# ── Kalshi API (required) ─────────────────────────────────────────────────
# Get from: https://app.kalshi.com/profile/api-keys
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=

# Use the demo environment (paper trading on demo.kalshi.co)
KALSHI_USE_DEMO=true

# ── Trading mode ──────────────────────────────────────────────────────────
# Set to false to place real orders. Leave true until you're confident.
DRY_RUN=true

# ── Risk limits ───────────────────────────────────────────────────────────
MAX_POSITION_USD=50.0
MAX_TOTAL_EXPOSURE_USD=500.0

# ── Signal sources (all optional) ────────────────────────────────────────
# Sports odds — free tier at https://the-odds-api.com (500 req/month)
THE_ODDS_API_KEY=

# FRED macro data — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# News headlines — free at https://newsapi.org
NEWS_API_KEY=

# LLM probability estimation — https://console.anthropic.com
# Also set LLM_ENABLED=true to turn it on
ANTHROPIC_API_KEY=
LLM_ENABLED=false

# ── Web dashboard ─────────────────────────────────────────────────────────
LEO_WEB_PORT=5002

# ── Misc ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
