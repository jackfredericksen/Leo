# Coinbase API credentials
# Generate at: https://www.coinbase.com/settings/api
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Arbitrage settings
MIN_PROFIT_PCT=0.02          # Minimum net profit % to execute a trade
MAX_POSITION_USD=100.0       # Max USD per trade
MAX_TOTAL_EXPOSURE_USD=500.0 # Max total open exposure
FEE_PCT=0.02                 # Coinbase Predictions fee per leg
MIN_LIQUIDITY_USD=1000.0     # Min market liquidity to consider
MIN_HOURS_TO_RESOLVE=1.0     # Ignore markets resolving sooner than this
MAX_HOURS_TO_RESOLVE=720.0   # Ignore markets resolving later than this
OVERROUND_THRESHOLD=0.98     # YES+NO ask sum must be below this to flag arb
POLL_INTERVAL_SEC=5          # Seconds between market scans

# Safety
DRY_RUN=true                 # Set to false to place real orders

# Logging
LOG_LEVEL=INFO
DB_PATH=data/leo.db
