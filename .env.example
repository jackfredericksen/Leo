# Kalshi API credentials — the backend powering Coinbase Predictions
# Generate at: https://app.kalshi.com/profile/api-keys
#
# Key ID shown in dashboard after creation
KALSHI_KEY_ID=your-key-id-here
#
# RSA private key PEM — shown ONCE at creation, save it immediately.
# Paste the full PEM with literal \n for newlines:
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAK...\n-----END RSA PRIVATE KEY-----
#
# Use Kalshi's demo environment for testing (no real money)
KALSHI_USE_DEMO=true

# Arbitrage settings
MIN_PROFIT_PCT=0.02           # Minimum net profit % to execute a trade
MAX_POSITION_USD=100.0        # Max USD per trade
MAX_TOTAL_EXPOSURE_USD=500.0  # Max total open exposure
FEE_PCT=0.02                  # Approx Kalshi fee (actual: $0.07×P×(1-P)/contract)
MIN_LIQUIDITY_USD=500.0       # Min market liquidity to consider
MIN_HOURS_TO_RESOLVE=1.0      # Ignore markets resolving sooner than this
MAX_HOURS_TO_RESOLVE=720.0    # Ignore markets resolving later than this
OVERROUND_THRESHOLD=1.02      # yes_bid + no_bid must exceed this to flag arb
POLL_INTERVAL_SEC=5           # Seconds between market scans

# Safety
DRY_RUN=true   # Set to false only after testing with KALSHI_USE_DEMO=true

# Logging
LOG_LEVEL=INFO
DB_PATH=data/leo.db
